# Copy to ".env" and edit. Never commit ".env".

# ===== Model server (what this app uses) =====
# The fine-tuned model runs as its own server (model project: bash scripts/start_server.sh).
# This app sends it the extracted document text and the question at POST /predict.
# Plain http is accepted only for localhost; anything else must be https.
MODEL_SERVER_URL=http://127.0.0.1:8765
# Only if the model server was started with SERVING_API_KEY. Sent as the X-API-Key header.
MODEL_SERVER_API_KEY=
# Seconds to wait for an answer from the model server.
GENERATION_TIMEOUT_SECONDS=120

# ===== Legacy in-process model (NOT used by the app any more) =====
# Base model used when training the LoRA adapter: a Hugging Face id or a local directory.
# Your training notebook (simple_pipeline.ipynb) used the base model "Qwen/Qwen1.5-0.5B";
# set it here only if that is what you actually trained on.
MODEL_NAME_OR_PATH=
# Directory of your saved LoRA adapter (contains adapter_config.json), i.e. the folder that
# the notebook wrote with model.save_pretrained(f"{OUT}/adapter"). Leave empty to run the
# base model only (it was not fine-tuned for the "### Answer:" format).
ADAPTER_PATH=
# Optional: tokenizer location if different from the base model.
TOKENIZER_NAME_OR_PATH=

# ===== Device / precision =====
# auto | cpu | mps | cuda   (auto = cuda, else mps, else cpu)
MODEL_DEVICE=auto
# auto | float32 | float16 | bfloat16   (auto = float32 on cpu, float16 otherwise)
MODEL_DTYPE=auto
MERGE_ADAPTER=false
TRUST_REMOTE_CODE=false
LOAD_MODEL_ON_STARTUP=true

# ===== Generation (always greedy, like the notebook's evaluation) =====
# The notebook evaluated with 32 new tokens; the answer is the first generated line.
MAX_NEW_TOKENS=64
# Maximum prompt tokens (whole document + question). The whole document is sent to the
# model; if it does not fit, its END is cut and the response says so.
MAX_INPUT_TOKENS=8192
# ===== Upload / extraction =====
MAX_UPLOAD_MB=20
MAX_PAGES=100
MAX_QUESTION_CHARS=2000
MIN_TEXT_CHARS=20
# Upper bound (characters) on the Markdown text echoed back to the browser.
MAX_MARKDOWN_RESPONSE_CHARS=200000

# ===== API =====
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
